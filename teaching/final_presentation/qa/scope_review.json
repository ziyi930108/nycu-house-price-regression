        "height": 60
      },
      "color": "#718082"
    },
    {
      "slide": 8,
      "slide_id": "sl/fu1gfa1s",
      "element_id": "sh/tkby9kzm",
      "text": "數值與類別採不同處理。所有需學習的轉換規則，只用當期訓練資料建立。",
      "position": {
        "left": 80,
