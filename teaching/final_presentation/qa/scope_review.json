        "height": 60
      },
      "color": "#718082"
    },
    {
      "slide": 10,
      "slide_id": "sl/m90b6t0r",
      "element_id": "sh/725onyl4",
      "text": "各模型先換回總價元，再進行分支融合與修正。驗證時固定參數。",
      "position": {
        "left": 80,
        "top": 645,
