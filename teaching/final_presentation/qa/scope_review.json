      "color": "#718082"
    },
    {
      "slide": 11,
      "slide_id": "sl/jetc3ut0",
      "element_id": "sh/61kzalof",
      "text": "面積權重對齊總價差距。另保留直接總價與對數學法，最後皆還原為元。",
      "position": {
        "left": 80,
        "top": 627,
        "width": 1110,
        "height": 60
      },
      "color": "#718082"
    },
    {
