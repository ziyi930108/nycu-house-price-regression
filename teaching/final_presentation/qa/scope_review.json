        "height": 60
      },
      "color": "#718082"
    },
    {
      "slide": 9,
      "slide_id": "sl/udsvah03",
      "element_id": "sh/mdonql4z",
      "text": "各起點重建模型、編碼及價格參考。窗口已反覆使用且重疊，無法視為四次獨立盲測。",
      "position": {
        "left": 80,
